# Listen
PORT=4000
BIND_ADDRESS=0.0.0.0

# Upstreams (defaults: 127.0.0.1:4002 identity, :4001 boards, :4003 workspace)
IDENTITY_UPSTREAM_URL=http://127.0.0.1:4002
BOARDS_UPSTREAM_URL=http://127.0.0.1:4001
WORKSPACE_UPSTREAM_URL=http://127.0.0.1:4003

# JWT verify (JWKS defaults to ${IDENTITY_UPSTREAM_URL}/api/v1/auth/jwks)
JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_CACHE_MAX_AGE_MS=
JWT_CLOCK_TOLERANCE_SECONDS=

# CORS (browser origins allowed to call the gateway)
CORS_ORIGINS=http://localhost:3000
CORS_PREFLIGHT_MAX_AGE_SECONDS=
